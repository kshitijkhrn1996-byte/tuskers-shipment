{
  "regions": ["bom1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": { "api/index.py": { "maxDuration": 60, "excludeFiles": "{.venv/**,node_modules/**,src/**,tests/**,scripts/**,public/**}" } }
}
